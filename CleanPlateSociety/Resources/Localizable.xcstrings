    "settings.oath.text" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I, **%@**, do solemnly pledge my fork and my knife to the pursuit of the spotless finish.\nI vow to honour the hands that sowed, the earth that grew, and the chef who prepared every morsel set before me.\nWith a grateful heart and a steady appetite, I promise to leave no trace, to waste no crumb, and to uphold the dignity of the Clean Plate Society at every seating, from this day forward.\n"
          }
        }
      }
    },
