    "section2.19" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You are commanded to maintain a stoic, unreadable disposition and ensure your mind remains completely guarded against culinary distractions. Do not brew any infusions, and you must strictly avoid the scent of brewing cauldrons or roasting hearths. This period of intense internal discipline isolates your focus from the chaotic impulses of the physical world."
