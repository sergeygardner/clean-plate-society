{
  "sourceLanguage" : "en",
  "strings" : {
    "section3.1" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The high office advises you to view this quiet interlude not as a restriction, but as a sacred cleansing of the vessel. True discipline is forged in the empty spaces between the feasts."
          }
        }
      }
    },
    "section3.2" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The high office reminds you that the hunger of the mind must be conquered before the hunger of the body can be mastered. Let your current emptiness become your greatest strength."
          }
        }
      }
    },
    "section3.3" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The high office suggests you use this time to contemplate the absolute precision of a truly empty dish. Preparation for the next challenge begins the moment the last meal ends."
          }
        }
      }
    },
    "section3.4" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The high office advises that a warrior of the table is defined by their patience during the famine just as much as their focus during the feast. Guard your focus with unwavering resolve."
          }
        }
      }
    },
    "section3.5" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The high office counsels you to treat this waiting period as an essential calibration of your internal discipline. True readiness leaves no room for impatience."
          }
        }
      }
    },
    "section3.6" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The high office reminds you that the cleanest plate is born from the most patient stomach. Embrace the stillness of the current hour."
          }
        }
      }
    },
    "section3.7" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The high office advises that true mastery requires a balance of vibrant action and absolute restraint. Let your hunger mature into a precise instrument of our order."
          }
        }
      }
    },
    "section3.8" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The high office suggests that wisdom is best cultivated when the physical senses are completely at rest. Let the void in your vessel clarify your devotion to the cause."
          }
        }
      }
    },
    "section3.9" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The high office counsels you to respect the profound balance that exists between consumption and restraint. True discipline cannot be rushed or circumvented."
          }
