      }
    },
    "section3.10" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The high office reminds you that even the most magnificent flame must occasionally rest beneath the ashes. Your patience now will elevate your next triumph."
          }
