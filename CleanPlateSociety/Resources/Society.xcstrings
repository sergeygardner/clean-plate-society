    },
    "society.subscription.introduction" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clean Plate Society is a developer-supported community, free from intrusive ads and data-mining. Our membership tiers are designed to provide sustainable value while keeping the lights on. Whether you are looking for full **Gold** access to our advanced toolset or simply want to contribute to the Developer Tip Jar to show your appreciation, this section explains how your membership works and how your support directly impacts the app’s future."
          }
        }
      }
    },
    "society.subscription.introduction.note" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supporting the Society"
          }
        }
      }
    },
    "society.subscription.introduction.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Subscriptions & Membership"
          }
        }
      }
    },
    "society.subscription.tipsmonthly.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your recurring tip fuels our mission to reduce global food waste. Help us continue providing the tools that make \"cleaning your plate\" better for you and the planet."
          }
        }
      }
    },
    "society.subscription.tipsmonthly.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Monthly Tip Jar"
          }
        }
      }
    },
    "society.subscription.tipsyearly.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Help us scale our tech and expand our clean-eating movement for the entire year. Your one-time annual tip provides a solid base for our next 12 months of growth."
          }
        }
      }
    },
    "society.subscription.tipsyearly.title" : {
