        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A celebration of the vibrant, whole foods that form the foundation of a clean plate. From the crunch of a fresh radish to the zest of a sun-ripened lemon, these stickers represent your commitment to unprocessed, earth-grown fuel."
          }
