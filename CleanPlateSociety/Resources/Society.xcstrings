    },
    "society.sticker.standard.hooked" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For those who believe the spotless finish is its own reward. The Standard sigil is the mark of the purist—no frills, just the classic blue and white of a job perfectly done. If you value tradition and the high-style of the Chancellor’s Office, this is your pack."
          }
        }
      }
    },
