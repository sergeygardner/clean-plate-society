          }
        }
      }
    },
    "society.stickers.out.of.data.description1" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Congratulations, **%@**! You have successfully filled your current logbook with every badge of your dedication. By conquering this collection, you have proven that your commitment was not a momentary whim, but a sustained victory over waste and want."
          }
        }
      }
    },
    "society.stickers.out.of.data.description2" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As the Society’s law dictates, once a collection reaches its Absolute finish, the old sigil must be retired to the Great Archive. You are now standing at the threshold of a new chapter. To continue your ascent, you must now choose a fresh Sticker Pack to mark your next mission."
          }
        }
      }
    },
    "society.stickers.out.of.data.engagement" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Begin the Next Cycle"
          }
        }
      }
    },
    "society.stickers.out.of.data.footnote" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The past is polished. The future is unwritten. Claim your next sigil and return to the table."
          }
        }
      }
    },
    "society.stickers.out.of.data.note" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Platter is Empty. The Collection is Full."
          }
        }
      }
    },
