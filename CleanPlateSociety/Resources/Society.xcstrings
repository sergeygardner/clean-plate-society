    "society.sticker.oath" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I swear by the porcelain and the plough to carry this sigil with the dignity befitting a member of the Clean Plate Society. I acknowledge that this is no mere decoration, but a sacred emblem of my intent."
          }
        }
      }
    },
    "society.sticker.squirrels.hooked" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masters of the small details. The Squirrel sigil is for the Zero-Waste Warrior who ensures even the smallest grain of rice or seed is rescued from the plate. You are agile, mindful, and treat every tiny resource as a treasure."
          }
        }
      }
    },
    "society.sticker.squirrels.name" : {
      "extractionState" : "manual",
