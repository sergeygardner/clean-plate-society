    "society.sticker.upload.oath" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I solemnly swear that the images I upload to this collection represent my genuine journey toward a cleaner plate. I promise to use these stickers to celebrate real food, mindful choices, and the honest progress I make each day. No shortcuts, no fillers - just pure intention."
          }
        }
      }
    },
