    "society.privacy.policy.introduction" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In the Clean Plate Society, we believe your data belongs to you - period. We are committed to radical transparency and **Privacy by Design**. This policy outlines the minimal data we collect to provide our services and the rigorous steps we take to protect it. We don't sell your information, and we don't track you across the web. Here, your privacy is a right, not a setting."
          }
        }
      }
    },
    "society.privacy.policy.introduction.note" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your Data, Your Plate"
          }
        }
      }
    },
    "society.privacy.policy.introduction.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Privacy Policy"
          }
        }
      }
    },
    "society.restore.purchase" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restore Purchase"
          }
        }
      }
    },
    "society.rules.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This Member’s Handbook serves as the definitive guide for every initiate of the Clean Plate Society. It’s designed to be a pocket-sized manual that ensures every member carries our values from the banquet hall to the breakfast nook."
          }
        }
      }
    },
    "society.rules.introduction" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every community is built on a shared set of values. The House Rules are the foundation of the Clean Plate Society - ensuring that every interaction, contribution, and shared milestone remains respectful, intentional, and focused on our collective growth. Before you pull up a chair, take a moment to understand how we maintain the integrity of our society."
          }
        }
      }
    },
    "society.rules.introduction.note" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Clean Plate Ethos"
          }
        }
      }
    },
    "society.rules.introduction.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Community Guidelines"
          }
        }
      }
    },
    "society.rules.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Official Member’s Handbook"
          }
        }
      }
    },
    "society.rules.section1.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Core Philosophy"
          }
        }
      }
    },
    "society.rules.section1.rule1" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Golden Rule: If it reaches the porcelain, it must reach the palate."
          }
        }
      }
    },
    "society.rules.section1.rule2" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Triple Respect: We eat to honour the Sower (the farmer), the Shaper (the chef), and the Sustenance (the food itself)."
          }
        }
      }
    },
    "society.rules.section1.rule3" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Zero-Waste Mandate: A clean plate is the ultimate protest against global food waste."
          }
        }
      }
    },
    "society.rules.section2.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The \"Plate-Clearing\" Protocols"
          }
        }
      }
    },
    "society.rules.section2.rule1" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Buffet Strategy: Take only what you can conquer. Multiple trips are a sign of wisdom; an abandoned mountain of food is a sign of weakness."
          }
        }
      }
    },
    "society.rules.section2.rule2" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The \"Difficult\" Ingredient: Members shall approach garnishes (parsley, kale, lemon wedges) with bravery. If it is edible, it is part of the mission."
          }
        }
      }
    },
    "society.rules.section2.rule3" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Sauce Salvage: Using a crust of bread to \"mop\" the remains of a sauce is not only permitted, it is encouraged as a high-level technical skill."
          }
        }
      }
    },
    "society.rules.section3.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Signs & Symbols"
          }
        }
      }
    },
    "society.rules.section3.rule1" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Official Salute: A brief, two-finger tap to the edge of one’s plate when passing a fellow member in a restaurant."
          }
        }
      }
    },
    "society.rules.section3.rule2" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The \"Finished\" Position: Cutlery must be placed at the 4:20 position (parallel and angled) to signal a successful mission to the staff."
          }
        }
      }
    },
    "society.rules.section3.rule3" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Secret Handshake: \"The Palate Polish”. This three-step gesture is designed to be discreet but unmistakable to fellow members:"
          }
        }
      }
    },
    "society.rules.section3.rule3.part1" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Grip: Start with a standard firm handshake."
          }
        }
      }
    },
    "society.rules.section3.rule3.part2" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Circle: While still holding hands, use your thumb to trace a quick, clockwise circle on the back of the other person's hand (symbolising a circular plate being wiped clean)."
          }
        }
      }
    },
    "society.rules.section3.rule3.part3" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Tap: End by tapping your index finger twice against your palm, mimicking the sound of a fork hitting a finished ceramic plate."
          }
        }
      }
    },
    "society.rules.section3.rule4" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Casual Sign-Off: \"The Invisible Crumb”. For a quicker, more \"street-level\" greeting among members:"
          }
        }
      }
    },
    "society.rules.section3.rule4.part1" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Make a \"C\" shape with your right hand (for \"Clean\")."
          }
        }
      }
    },
    "society.rules.section3.rule4.part2" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Briefly mimic the motion of wiping a table or plate from left to right."
          }
        }
      }
    },
    "society.rules.section3.rule4.part3" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "End with a \"thumbs up\" or a satisfied pat of the stomach."
          }
        }
      }
    },
    "society.rules.section4.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ranks of the Society"
          }
        }
      }
    },
    "society.rules.section5.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Penalty Box"
          }
        }
      }
    },
    "society.rules.section5.rule1" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Leftover Lapse: Any member who leaves more than a \"smidgen\" behind must perform the \"Dishwasher’s Penance\" (clearing the table for the rest of the group)."
          }
        }
      }
    },
    "society.rules.section6.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dining Out"
          }
        }
      }
    },
    "society.rules.section6.rule1" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Pre-Mission Briefing (Ordering). Mastering the clean plate begins before the food hits the table."
          }
        }
      }
    },
    "society.rules.section6.rule1.part1" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The \"Small Plates\" Strategy: Prioritise appetisers, side dishes, or \"small appetite\" portions if listed on the menu."
          }
        }
      }
    },
    "society.rules.section6.rule1.part2" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Shared Victory: Propose splitting an entrée with a fellow diner to ensure both plates end up empty."
          }
        }
      }
    },
    "society.rules.section6.rule1.part3" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Customised Commands: Ask for dressings and sauces on the side to control your intake, and explicitly decline the bread or chip basket if you know it will prevent you from finishing your main meal."
          }
        }
      }
    },
    "society.rules.section6.rule2" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The \"Box-First\" Manoeuvre. When a \"mountain of food\" is inevitable, use the Immediate Partition technique:"
          }
        }
      }
    },
    "society.rules.section6.rule2.part1" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Half-Plate Split: As soon as your meal arrives, divide the plate in half."
          }
        }
      }
    },
    "society.rules.section6.rule2.part2" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Request the \"Safe-Keep\": Ask for a takeaway container at the start of the meal. Move the surplus portion into the box immediately to \"secure tomorrow's dinner\"."
          }
        }
      }
    },
    "society.rules.section6.rule2.part3" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Invisible Leftover: By boxing half immediately, you transform a daunting portion into a perfectly finishable \"Clean Plate\" mission on your table."
          }
        }
      }
    },
    "society.rules.section6.rule3" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tactical Consumption"
          }
        }
      }
    },
    "society.rules.section6.rule3.part1" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Vegetable Vanguard: Focus on high-volume, fiber-rich vegetables first to satisfy hunger while ensuring you have the \"room\" to polish off the rest."
          }
        }
      }
    },
    "society.rules.section6.rule3.part2" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mindful Pacing: Eat slowly and savour every bite. This allows your brain to register fullness before you are forced to overeat purely for the sake of the oath."
          }
        }
      }
    },
    "society.rules.section6.rule3.part3" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The \"No-Go\" Zone: Avoid buffets and \"all-you-can-eat\" settings, where portion control is nearly impossible, and the risk of breaking the oath is at its highest. "
          }
        }
      }
    },
    "society.slogan" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every Crumb a Commitment, Every Plate a Promise"
          }
        }
      }
    },
