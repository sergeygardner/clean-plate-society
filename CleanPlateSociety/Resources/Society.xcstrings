    "society.sticker.manual3.hooked" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A minimalist collection designed for the modern minimalist eater. These stickers represent the \"clean\" in Clean Plate focusing on clarity, transparency, and the simple joy of knowing exactly what goes into your body."
          }
        }
      }
    },
    "society.sticker.manual3.name" : {
