            "state" : "translated",
            "value" : "Terms of use"
          }
        }
      }
    },
    "society.theme.forest.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deep Green and Earth. Dedicated to our Zero-Waste Warriors. These colours represent the Planet, the Soil, and our commitment to a sustainable future. It is a reminder of the life that precedes the plate."
          }
        }
      }
    },
    "society.theme.forest.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Forest Verdant"
          }
        }
      }
    },
    "society.theme.formal.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Black and Gold. The ultimate mark of authority. This theme uses deep black ink paired with a regal gold trim, designed for those who treat every meal with the high-stakes gravity of a state banquet. It is the pinnacle of Society elegance."
          }
        }
      }
    },
    "society.theme.formal.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Formal Prestige"
          }
        }
      }
    },
    "society.theme.harvest.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warm Yellow and Amber. A theme inspired by the Sun and the Grain. It celebrates the abundance of the earth and the warmth of a satisfied appetite. Perfect for those who view every meal as a celebration of the harvest."
          }
        }
      }
    },
    "society.theme.harvest.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Harvest Gold"
          }
        }
      }
    },
    "society.theme.midnight.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Charcoal and Silver. Inspired by the Stove and the Chef's Knife. A sharp, high-contrast theme for those who respect the intensity of the kitchen and the precision required for a Technical Titan’s sweep."
          }
        }
      }
    },
    "society.theme.midnight.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Midnight Iron"
          }
        }
      }
    },
    "society.theme.royal.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Classic White and Blue. The traditional colours of the Society. This theme evokes the image of a perfectly glazed, vintage dinner plate. It represents purity, tradition, and the standard of a spotless finish."
          }
        }
      }
    },
    "society.theme.royal.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Royal Porcelain"
          }
        }
      }
    },
    "society.tutorial.stage1.button.text" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agree"
          }
        }
      }
    },
    "society.tutorial.stage1.text" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Welcome to the table!\n\nWe’re thrilled to have another member who truly values every bite and leaves nothing behind."
          }
        }
      }
    },
    "society.tutorial.stage2.button.text" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accept the Duty"
          }
        }
      }
    },
    "society.tutorial.stage2.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Clean Plate Society recognises that the path to a spotless life requires varying degrees of discipline. Every member must declare their Commitment Tier at the start of each lunar cycle to ensure the integrity of the collective."
          }
        }
      }
    },
    "society.tutorial.stage2.note" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claim your commitment tier:"
          }
        }
      }
    },
    "society.tutorial.stage2.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Tiers of Culinary Commitment"
          }
        }
      }
    },
    "society.tutorial.stage3.button.text" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claim My Sigil"
          }
        }
      }
    },
    "society.tutorial.stage3.description1" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A plate is not truly yours until it has been marked by the Society’s seal. Every member is required to select a Commemorative Sticker Pack to identify their dedicated dining gear and track their progress in the official logbook."
          }
        }
      }
    },
    "society.tutorial.stage3.description2" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whether you choose the classic Standard emblem or find your spirit animal among the %@, these stickers serve as a visual oath to the table. They are the badges of your bravery and the markers of your mission; carry them with pride as you transform every meal into a masterpiece of completion. Choose your pack, mark your territory, and let no crumb go unrecorded."
          }
        }
      }
    },
    "society.tutorial.stage3.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claim Your Sigil: The Sticker Selection"
          }
        }
      }
    },
    "society.tutorial.stage4.button.text" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Let the feast begin"
          }
        }
      }
    },
    "society.tutorial.stage4.caption1" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose your colour, and let your legacy be written in the shade of your success."
          }
        }
      }
    },
    "society.tutorial.stage4.caption2" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Once selected, your chosen palette will be applied to your Member ID and all subsequent official scrolls."
          }
        }
      }
    },
    "society.tutorial.stage4.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every word from the Chancellor’s Office should reflect the spirit of your commitment. Before the first scrolls are sent, you are invited to choose the Colour Theme for your future correspondence. This pigment will mark your letters, seals, and digital missives, binding your personal journey to the history of the Society."
          }
        }
      }
    },
    "society.tutorial.stage4.note" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Please select the hue of your future dispatches:"
          }
        }
      }
    },
    "society.tutorial.stage4.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Chancellor’s Ink: Choose Your Signature Colour"
          }
        }
      }
    },
    "subscriptions.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Subscriptions"
          }
        }
      }
    }
  },
  "version" : "1.1"
}