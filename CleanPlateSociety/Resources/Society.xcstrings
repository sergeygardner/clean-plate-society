    "society.chancellor.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The High Chancellor of the Great Beyond"
          }
        }
      }
    },
    "society.chancellor.signed.and.sealed" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Signed and Sealed on this day,"
          }
        }
      }
    },
    "society.difficulty.level.high.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The pinnacle of earthly discipline. Members of this tier commit to the Triple Crown of Dining, pledging to finish every morsel at breakfast, lunch, and dinner. This level of dedication is the only path to the higher ranks of the Technical Titan and is the ultimate tribute to the Chef and the Soil."
          }
        }
      }
    },
    "society.difficulty.level.high.label" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The High Tier"
          }
        }
      }
    },
    "society.difficulty.level.high.note" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Sovereign’s Shadow"
          }
        }
      }
    },
    "society.difficulty.level.high.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The High Tier: Thrice Daily"
          }
        }
      }
    },
    "society.difficulty.level.low.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Members at this level pledge their honor to a single daily victory. Whether at breakfast, lunch, or dinner, the initiate must deliver one perfectly polished plate every twenty-four hours. This tier is reserved for those balancing the Society’s demands with outside worldly duties."
          }
        }
      }
    },
    "society.difficulty.level.low.label" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Low Tier"
          }
        }
      }
    },
    "society.difficulty.level.low.note" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Morning or Evening Sentinel"
          }
        }
      }
    },
    "society.difficulty.level.low.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Low Tier: Once Daily"
          }
        }
      }
    },
    "society.difficulty.level.medium.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A significant step toward mastery, this level requires a dual daily devotion. The member vows to clear their plate during two of the three primary seatings. Achieving the Medium Tier demonstrates a shift from casual dining to a lifestyle defined by the consistent spotless finish."
          }
        }
      }
    },
    "society.difficulty.level.medium.label" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Medium Tier"
          }
        }
      }
    },
    "society.difficulty.level.medium.note" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Pillar of Persistence"
          }
        }
      }
    },
    "society.difficulty.level.medium.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Medium Tier: Twice Daily"
          }
        }
      }
    },
    "society.error.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Technical Observation:"
          }
        }
      }
    },
    "society.error.hello" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Honoured Member,"
          }
        }
      }
    },
    "society.error.intro" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We regret to inform you that a disruption has occurred within the Great Archive. The digital vessel required to store your commitments has failed to reach its absolute state. At this moment, your progress cannot be etched into the Sovereign’s Ledger."
          }
        }
      }
    },
    "society.error.note1" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Seal is Broken. The Ledger is Unreachable."
          }
        }
      }
    },
    "society.error.note2" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The past is preserved in spirit; the future awaits the restoration of the stone."
          }
        }
      }
    },
    "society.error.outro" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do not be discouraged. This is a moment for Vigilance, not despair. Our architects have been notified of this shadow upon the records. We ask that you remain patient while the High Office works to restore the purity of your data."
          }
        }
      }
    },
    "society.error.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PROCLAMATION: A DISRUPTION IN THE RECORDS"
          }
        }
      }
    },
    "society.greetings" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Greetings, **%@**."
          }
        }
      }
    },
    "society.legal.purchase" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Subscription automatically renews unless cancelled at least 24 hours before the end of the current period. Manage subscriptions in App Store Account Settings."
          }
        }
      }
    },
    "society.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Clean Plate Society"
          }
        }
      }
    },
    "society.next.appointment.description1" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**%@**, your request for an audience has been formally received and ratified by the **High Office**"
          }
        }
      }
    },
    "society.next.appointment.description2" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You are now invited to enter the **Phase of Preparation**. This period of anticipation is a sacred requirement; it is the time during which a member must demonstrate that their commitment is as enduring as the porcelain itself. The Chancellor is currently reviewing your **Society Records** and preparing the **Sacred Ink** for your arrival."
          }
        }
      }
    },
    "society.next.appointment.description3" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maintain your discipline at every seating. Your hour has been etched into the **Great Ledger**, and the Society awaits the brilliance of your next report."
          }
        }
      }
    },
    "society.next.appointment.status" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Next appointment in"
          }
        }
      }
    },
    "society.next.appointment.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acceptance of the Private Audience"
          }
        }
      }
    },
