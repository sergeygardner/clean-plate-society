        "section2.1": {
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "You have walked the path of the fully consumed meal, leaving nothing but bare porcelain in your wake. Your discipline shines brightly in a wasteful world, reflecting the core virtues of our culinary order. Now, your ultimate triumph must be permanently recorded."
                    }
                }
            }
        },
        "section2.2": {
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "You have conquered the feast set before you, clearing every crumb with admirable determination. The High Chancellor notes your dedication to the sacred laws of the kitchen table. Your immaculate plate stands as a testament to your focus."
                    }
