{
    "sourceLanguage": "en",
    "strings": {
        "day.1": {
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Welcome! You have clearly mastered the art of the final forkful. We are honoured to have a diner who treats every meal like a masterpiece that deserves a clean finish."
                    }
                }
            }
        },
        "day.2": {
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Greetings, fellow Steward of the Soil. Your commitment to a spotless plate is the ultimate thank-you to the planet. We are thrilled to have you join our zero-waste ranks."
                    }
                }
            }
        },
        "day.3": {
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "The table is set and your seat is ready. We have noticed your spotless track record, and we are proud to call you one of our own. Welcome to the inner circle of the empty platter."
                    }
                }
            }
        },
        "day.4": {
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Clear plates, full hearts! You have got the grit and the appetite we look for in this society. Grab a napkin and get ready\u2014the next mission is about to be served!"
                    }
                }
            }
        },
        "day.5": {
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Welcome to the fold! You understand that a clean plate is a silent song of gratitude to the chef. We look forward to seeing your porcelain shine at every seating."
                    }
                }
            }
        },
        "day.6": {
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Nice work on that clean sweep! You are officially one of us now. Pull up a chair and remember: no crumb left behind!"
                    }
                }
            }
        },
        "day.7": {
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Welcome to the society! Your commitment to a clean plate shows a deep respect for the meal and the hands that prepared it. We are proud to have you join our empty-platter ranks."
                    }
                }
            }
        },
        "day.8": {
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Congratulations on your membership! By finishing every morsel, you are leading the charge against food waste. We look forward to seeing your sparkling, empty plate at the next seating."
                    }
                }
            }
        },
        "day.9": {
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "A seat is saved for you! You have mastered the art of the perfect finish, proving that good food deserves to be fully enjoyed. Welcome to a community that savours every last crumb."
                    }
                }
            }
        },
        "day.10": {
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "It is an honour to welcome you into our ranks as a steward of the empty plate. Your dedication to finishing every meal reflects a profound respect for our resources and culinary heritage. May your future seat at our table always be marked by a spotless finish."
                    }
                }
            }
        },
        "day.11": {
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "We formally recognise your commitment to the values of the Clean Plate Society. By leaving nothing behind, you uphold our mission to eliminate waste and honour the bounty provided. Welcome to a distinguished circle of mindful diners."
                    }
                }
            }
        },
        "day.12": {
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Welcome to the crew! We love seeing a plate so clean it looks like it is already been washed. Pull up a chair and get ready for some serious good eats, no crumb left behind!"
                    }
                }
            }
        },
        "day.13": {
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "So glad to have you with us! You are clearly a pro at the 'clean sweep,' and we can not wait to see you tackle the next course. Here is to empty plates and full stomachs!"
                    }
                }
            }
        },
        "day.14": {
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Welcome to the table! Your plate is a mirror of your dedication."
                    }
                }
            }
        },
        "day.15": {
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "A spotless dish is your membership card. Wear it with pride!"
                    }
                }
            }
        },
        "day.16": {
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "You have joined the ranks of the finishers. Let no crumb stand in your way."
                    }
                }
            }
        },
        "day.17": {
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "The porcelain is clear, and so is your path. Welcome to the Society."
                    }
                }
            }
        },
        "day.18": {
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "One meal, one mission, one clean plate. Glad to have you aboard."
                    }
                }
            }
        },
        "day.19": {
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "You eat with purpose and finish with poise. Welcome to our ranks."
                    }
                }
            }
        },
        "day.20": {
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "The Society grows stronger with every polished platter. Welcome!"
                    }
                }
            }
        },
        "day.21": {
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Spring has sprung, and your plate is cleared. A fresh start for a new member!"
                    }
                }
            }
        },
        "day.22": {
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "As the seeds grow, so does your appetite for excellence. Welcome."
                    }
                }
            }
        },
        "day.23": {
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Summer's bounty deserves a clean finish. You have done the sun proud today."
                    }
                }
            }
        },
        "day.24": {
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "The harvest is gathered, and your plate is bare. Welcome to the cycle."
                    }
                }
            }
        },
        "day.25": {
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Winter's chill meets a heart-warming finish. Your seat is warm here."
                    }
                }
            }
        },
        "day.26": {
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Like a falling leaf, every morsel has found its place. Welcome!"
                    }
                }
            }
        },
        "day.27": {
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "The earth provides, and you respect the gift. A true member indeed."
                    }
                }
            }
        },
        "day.28": {
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "The kitchen sends its thanks; a clean plate is the best review. Welcome!"
                    }
                }
            }
        },
        "day.29": {
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "You have spoken the chef's favorite language: the language of the empty dish."
                    }
                }
            }
        },
        "day.30": {
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "A silent 'bravo' to the cook. We saw that finish\u2014impressive work!"
                    }
                }
            }
        },
        "day.31": {
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Your plate is a love letter to the stove. Welcome to the family."
                    }
                }
            }
        },
        "day.32": {
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "The pan sizzled for you, and you didn't let it down. Welcome aboard."
                    }
                }
            }
        },
        "day.33": {
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "You honor the chef with every bite. You belong at this table."
                    }
                }
            }
        },
        "day.34": {
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Waste not, want not, and welcome to the lot! You are a hero of the bin."
                    }
                }
            }
        },
        "day.35": {
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Every scrap saved is a victory for the planet. Proud to have you."
                    }
                }
            }
        },
        "day.36": {
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "You leave no footprint on the plate, only a legacy of respect. Welcome."
                    }
                }
            }
        },
        "day.37": {
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "The bin is empty because your heart is full. Join us at the head of the table."
                    }
                }
            }
        },
        "day.38": {
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "A clean plate is a green planet. Thank you for your service, member."
                    }
                }
            }
        },
        "day.39": {
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "You have mastered the art of the 'Zero-Trace' meal. Welcome to the vanguard."
                    }
                }
            }
        },
        "day.40": {
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "That was a textbook 'Sauce-Sweep.' You have got the hands of a pro. Welcome!"
                    }
                }
            }
        },
        "day.41": {
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "No noodle left behind\u2014a true display of fork-titude. Glad you are here."
                    }
                }
            }
        },
        "day.42": {
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "You conquered the crust and the garnish too. A complete victory! Welcome."
                    }
                }
            }
        },
        "day.43": {
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Your 'Mop-Up' game is elite. We have been watching your progress with joy."
                    }
                }
            }
        },
        "day.44": {
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "The corners of the bowl are the hardest, but you cleared them all. Welcome."
                    }
                }
            }
        },
        "day.45": {
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "A masterful finish to a challenging dish. You have earned your badge."
                    }
                }
            }
        },
        "day.46": {
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Three times a day, you prove your worth. Welcome to your daily duty."
                    }
                }
            }
        },
        "day.47": {
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Consistency is the secret sauce of this society. You have got it. Welcome."
                    }
                }
            }
        },
        "day.48": {
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Sunup or sundown, your plate is always the same: empty. Welcome."
                    }
                }
            }
        },
        "day.49": {
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "A habit of excellence starts at the breakfast table. Good morning, member."
                    }
                }
            }
        },
        "day.50": {
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Lunch was a triumph; we can not wait to see your dinner. Welcome back."
                    }
                }
            }
        },
        "day.51": {
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "The midnight snack was also cleared - true dedication! Welcome."
                    }
                }
            }
        },
        "day.52": {
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Day 365: The final plate of the year is as clean as the first. Welcome to the legacy."
                    }
                }
            }
        },
        "day.53": {
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "An extra day for an extra finish. You have cleared the leap! Welcome to the eternal table."
                    }
                }
            }
        },
        "day.54": {
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Leap Year Special: An extra day for an extra finish! Your tray is immaculate and mastered."
                    }
                }
            }
        },
        "day.55": {
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Welcome! You've honoured your dish until it is victorious. A true member's finish."
                    }
                }
            }
        },
        "day.56": {
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Greetings! That dish is victorious. You honor the Society with such a swept meal."
                    }
                }
            }
        },
        "day.57": {
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Hail, Member! Your plate is looking spotless today. The kitchen thanks you for a finished dish."
                    }
                }
            }
        },
        "day.58": {
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Well done! A spotless plate is the mark of a pro. Consider this meal conquered."
                    }
                }
            }
        },
        "day.59": {
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Greetings! That plate is spotless. You honor the Society with such a polished meal."
                    }
                }
            }
        },
        "day.60": {
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "A warm welcome! Your pride in this meal is shown by its purposeful finish."
                    }
                }
            }
        },
        "day.61": {
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "With great purpose, you have earned a welcome seat. Wear your pride on your sleeve."
                    }
                }
            }
        },
        "day.62": {
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "We welcome your appetite. Your purpose was clear; your pride is earned."
                    }
                }
            }
        },
        "day.63": {
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "To the purposeful diner, we offer a welcome. Take pride in that bare plate."
                    }
                }
            }
        },
        "day.64": {
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Your pride is our joy. Welcome to a community of purpose."
                    }
                }
            }
        },
        "day.65": {
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "A purposeful bite leads to a prideful finish. Welcome to the table."
                    }
                }
            }
        },
        "day.66": {
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "In this Society, purpose meets pride. You are most welcome."
                    }
                }
            }
        },
        "day.67": {
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Welcome! You have found your purpose at the bottom of the bowl. Take pride."
                    }
                }
            }
        },
        "day.68": {
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "From the seed to the soil, you have honoured the harvest under the sun and rain."
                    }
                }
            }
        },
        "day.69": {
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "The rain fell and the sun shone so this seed could reach your soil-free plate. Happy harvest!"
                    }
                }
            }
        },
        "day.70": {
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Respect the harvest. The soil and seed thank you for leaving no trace of the rain's bounty."
                    }
                }
            }
        },
        "day.71": {
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Under the sun, we celebrate the harvest. From seed to finish, you did it!"
                    }
                }
            }
        },
        "day.72": {
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "The soil gave its best. You returned a clean plate. A perfect harvest of seed and sun."
                    }
                }
            }
        },
        "day.73": {
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Whether rain or sun, the seed grew for this harvest. Honor the soil and finish!"
                    }
                }
            }
        },
        "day.74": {
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "A harvest well-handled. You have respected every seed and every drop of rain."
                    }
                }
            }
        },
        "day.75": {
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "The sun sets on a clean plate. From the soil up, you have mastered the harvest."
                    }
                }
            }
        },
        "day.76": {
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "The chef used the knife and the heat of the stove to create this flavour. Bravo!"
                    }
                }
            }
        },
        "day.77": {
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Honour the chef's knife skills. The stove's heat produced a flavour worth finishing."
                    }
                }
            }
        },
        "day.78": {
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Every flavour was earned through heat. The chef and the stove salute your finish."
                    }
                }
            }
        },
        "day.79": {
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "A master of the stove meets a master of the meal. The chef loves your flavour-sweep!"
                    }
                }
            }
        },
        "day.80": {
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "From the knife's edge to the stove's heat, you have captured every flavour."
                    }
                }
            }
        },
        "day.81": {
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "The chef's heat turned flavour into art. Your clean plate is the final stroke."
                    }
                }
            }
        },
        "day.82": {
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Respect the stove. The chef's knife and your appetite are a perfect match."
                    }
                }
            }
        },
        "day.83": {
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "For the planet and our future, you have turned waste into a green resource."
                    }
                }
            }
        },
        "day.84": {
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "A green choice for a better future. You have protected the planet's resources today."
                    }
                }
            }
        },
        "day.85": {
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Zero waste is the resource of the future. The planet stays green with your help."
                    }
                }
